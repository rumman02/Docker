# ==============================================================================
# 1. IMAGE TAGS
# ==============================================================================
# Container image tag for pause container (busybox). Required.
NET_ANCHOR_IMAGE_TAG=9.9.9

# ==============================================================================
# 2. NETWORK INFRASTRUCTURE
# ==============================================================================
# Pinned subnet of owned traefik_net bridge. Required.
TRAEFIK_NET_SUBNET=10.250.0.0/24
# Gateway of TRAEFIK_NET_SUBNET. Required.
TRAEFIK_NET_GATEWAY=10.250.0.1

# ==============================================================================
# 3. RESOURCE LIMITS
# ==============================================================================
# CPU ceiling in cores. Required.
NET_ANCHOR_LIMIT_CPUS=0.25
# Memory ceiling. Required.
NET_ANCHOR_LIMIT_MEMORY=96M
# Maximum processes. Required.
NET_ANCHOR_LIMIT_PIDS=64
