# ==============================================================================
# GLOBAL DOMAIN & SHARED RUNTIME CONFIGURATION TEMPLATE (.env.global.example)
# Copy to .env.global and run `./sync-env` to propagate.
# ==============================================================================

# --- Global Domain ---
BASE_DOMAIN=example.com

# --- Global Runtime (Consuming Stacks Only) ---
# Host and container timezone, IANA name. Synced to stacks whose compose.yaml
# or .env values reference it.
TZ=Etc/UTC
