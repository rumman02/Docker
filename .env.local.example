# ==============================================================================
# LOCAL SECRETS & TOKENS TEMPLATE (.env.local.example)
# Copy to .env.local, fill in real secrets, and run `./sync-env` to propagate.
# Variables prefixed with <STACK>_ auto-route to that specific stack.
# ==============================================================================

# --- Network Stack Secrets (Auto-routes to network/.env) ---
NETWORK_CF_DNS_API_TOKEN=cfut_placeholder
NETWORK_ACME_EMAIL=admin@example.com
NETWORK_TAILSCALE_IP=100.64.0.1
NETWORK_TAILSCALE_HOSTNAME=my-docker-host
NETWORK_TS_AUTHKEY=tskey-auth-placeholder
NETWORK_CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoi...

# --- Socket Proxy Host Values (unprefixed, reference-routed to network/.env) ---
# uid:gid the socket_proxy container runs as — per-host value, see HOSTS.md (required)
SOCKET_PROXY_USER=65534:0
# Host-side container engine socket path supplied read-only into proxy — per-host value, see HOSTS.md (required)
SOCKET_PROXY_DOCKER_SOCKET=/run/engine/docker.sock
# In-container mount path for the engine socket — feeds the bind target and SP_SOCKETPATH, must match the proxy's expectation (required)
SOCKET_PROXY_INTERNAL_SOCKET_PATH=/run/engine/docker.sock
