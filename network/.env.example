# ==============================================================================
# 1. DOMAIN CONFIGURATION
# ==============================================================================
# Base domain shared by every stack on this host. Required.
BASE_DOMAIN=example.com
# CoreDNS local authoritative zone; alias of the synced global BASE_DOMAIN. Required.
DNS_DOMAIN=${BASE_DOMAIN}
# Host and container timezone. Required.
TZ=Etc/UTC

# ==============================================================================
# 2. HOST & CLOUD SECRETS
# ==============================================================================
# Cloudflare DNS API token with Zone.DNS:Edit permissions for ACME DNS-01 challenges. Required.
NETWORK_CF_DNS_API_TOKEN=cfut_placeholder
# ACME registration email address for Let's Encrypt notifications.
NETWORK_ACME_EMAIL=admin@example.com
# Tailscale assigned IPv4 address for this node. Required.
NETWORK_TAILSCALE_IP=100.64.0.1
# Tailscale machine hostname within the tailnet. Required.
NETWORK_TAILSCALE_HOSTNAME=my-docker-host
# Tailscale pre-authenticated auth key. Required.
NETWORK_TS_AUTHKEY=tskey-auth-placeholder
# Cloudflare Tunnel credentials token. Required.
NETWORK_CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoi...

# ==============================================================================
# 3. IMAGE TAGS
# ==============================================================================
# Traefik image tag — pinned repo:tag, never latest (required)
TRAEFIK_IMAGE_TAG=9.9.9
# Pinned image tag, never latest (required)
SOCKET_PROXY_IMAGE_TAG=9.9.9
# Pinned image tag, never latest. Required.
TAILSCALE_IMAGE_TAG=v9.9.9
# cloudflare/cloudflared image tag. Pinned, never latest. Required.
CLOUDFLARED_IMAGE_TAG=9999.9.9
# CoreDNS image tag — pinned, never latest (required)
COREDNS_IMAGE_TAG=9.9.9

# ==============================================================================
# 4. SERVICE RUNTIME & ROUTING CONFIGURATION
# ==============================================================================
# Strategy for request headers with aliasing names — delete, reject, keep (required)
TRAEFIK_GLOBAL_ALIASHEADERSSTRATEGY=delete
# websecure entrypoint listen port (required)
TRAEFIK_WEBSECURE_INTERNAL_PORT=554
# ping-only entrypoint listen port (required)
TRAEFIK_PING_INTERNAL_PORT=9193
# TCP port the proxy listens on inside the container (required)
SOCKET_PROXY_INTERNAL_PORT=3486
# Consumer names allowed to reach the socket proxy, comma-separated (required)
SOCKET_PROXY_ALLOWFROM=tailscale,openwa
# Traefik log level — DEBUG, INFO, WARN, ERROR (optional)
TRAEFIK_LOG_LEVEL=INFO
# Access log to stdout — true/false (optional)
TRAEFIK_ACCESS_LOG=true
# uid:gid the socket_proxy container runs as — per-host value, see HOSTS.md (required)
SOCKET_PROXY_USER=65534:0
# Host-side container engine socket path supplied read-only into proxy — per-host value, see HOSTS.md (required)
SOCKET_PROXY_DOCKER_SOCKET=/run/engine/docker.sock
# In-container mount path for the engine socket — feeds the bind target and SP_SOCKETPATH, must match the proxy's expectation (required)
SOCKET_PROXY_INTERNAL_SOCKET_PATH=/run/engine/docker.sock
# Maximum time in seconds to wait for socket-proxy server to shut down gracefully (required)
SOCKET_PROXY_SHUTDOWN_GRACE_TIME=30
# Capability for network configuration (required)
TAILSCALE_CAP_ADD=NET_ADMIN
# Tun device path mapping host→container (required)
TAILSCALE_TUN_DEVICE=/dev/net/tun:/dev/net/tun
# Run Tailscale mode: true = userspace, false = kernel mode (required)
TS_USERSPACE=false
# Container-side port for built-in /healthz endpoint (required)
TAILSCALE_HEALTHCHECK_INTERNAL_PORT=9113
# Primary upstream DNS resolver (required)
NETWORK_DNS_PRIMARY=1.1.1.1
# Secondary upstream DNS resolver (required)
NETWORK_DNS_SECONDARY=8.8.8.8
# DNS listen port inside the container (required)
COREDNS_INTERNAL_PORT=64
# tailnet-only IP allowlist sourcerange (required)
TAILNET_ONLY_SOURCE_RANGE=100.64.0.0/10, 10.99.99.99/32

# ==============================================================================
# 5. RESOURCE LIMITS
# ==============================================================================
# CPU ceiling in cores. Required.
NETWORK_TRAEFIK_LIMIT_CPUS=1.00
# Memory ceiling. Required.
NETWORK_TRAEFIK_LIMIT_MEMORY=384M
# Maximum processes. Required.
NETWORK_TRAEFIK_LIMIT_PIDS=128
# CPU ceiling in cores. Required.
NETWORK_SOCKET_PROXY_LIMIT_CPUS=0.25
# Memory ceiling. Required.
NETWORK_SOCKET_PROXY_LIMIT_MEMORY=96M
# Maximum processes. Required.
NETWORK_SOCKET_PROXY_LIMIT_PIDS=64
# CPU ceiling in cores. Required.
NETWORK_TAILSCALE_LIMIT_CPUS=0.50
# Memory ceiling. Required.
NETWORK_TAILSCALE_LIMIT_MEMORY=256M
# Maximum processes. Required.
NETWORK_TAILSCALE_LIMIT_PIDS=128
# CPU ceiling in cores. Required.
NETWORK_CLOUDFLARED_LIMIT_CPUS=0.50
# Memory ceiling. Required.
NETWORK_CLOUDFLARED_LIMIT_MEMORY=256M
# Maximum processes. Required.
NETWORK_CLOUDFLARED_LIMIT_PIDS=128
# CPU ceiling in cores. Required.
NETWORK_COREDNS_LIMIT_CPUS=0.50
# Memory ceiling. Required.
NETWORK_COREDNS_LIMIT_MEMORY=256M
# Maximum processes. Required.
NETWORK_COREDNS_LIMIT_PIDS=128
